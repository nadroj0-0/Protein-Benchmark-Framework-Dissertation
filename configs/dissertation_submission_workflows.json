  "analysis_defaults": {
    "specificity": {
      "measure": "all_separate",
      "positive_bins": 4,
      "bootstrap_replicates": 2000,
      "bootstrap_seed": 42
    },
    "calibration": {
      "positive_ia_bins": 4,
      "reliability_bins": 10
    },
    "confidence_methods": [
      "raw-sigmoid",
      "ffpred-style",
      "hierarchy-calibrated"
    ],
    "relationship_policy_comparison": {
      "primary": "accepted-all-relationships",
      "sensitivity": "diagnostic-is-a-plus-part-of"

{
  "schema_version": 1,
  "run_name": "dissertation-benchmark-forensics",
  "top_n": 20,
  "datasets": [
    {
      "id": "cafa3-published",
      "benchmark_dir": "/path/to/cafa3/published/csvs",
      "obo_file": "/path/to/cafa3/go.obo",
      "allow_legacy_singular_protein_header": true,
      "allow_all_zero_rows": false,
      "split_overlap_policy": "disallow",
      "source_annotations": {
        "type": "pfp-pickle-directory",
        "path": "/path/to/cafa3/pre_projection_pickles",
        "projection_policy": "Published DeepGOPlus/PFP min_count=50 label-universe projection"
      },
      "taxonomy_sources": [
        {"type": "uniprot-dat", "path": "/path/to/2025/trembl.dat.gz", "name": "uniprot-2025-01-trembl", "priority": 100},
        {"type": "uniprot-dat", "path": "/path/to/2025/swissprot.dat.gz", "name": "uniprot-2025-01-swissprot", "priority": 200},
        {"type": "uniprot-dat", "path": "/path/to/2026/trembl.dat.gz", "name": "uniprot-2026-02-trembl", "priority": 300},
        {"type": "uniprot-dat", "path": "/path/to/2026/swissprot.dat.gz", "name": "uniprot-2026-02-swissprot", "priority": 400}
      ],
      "modality_inventory": {
        "type": "long-table",
        "path": "/path/to/cafa3/embedding_inventory.tsv.gz",
        "protein_id_column": "protein_id",
        "modality_column": "modality",
        "states": {
          "published_embedding_available": {
            "column": "scientifically_eligible",
            "true_values": ["true"]
          }
        }
      }
    },
    {
      "id": "contemporary-2025-01-to-2026-02-global-nk",
      "benchmark_dir": "/path/to/contemporary/global_nk/csvs",
      "obo_file": "/path/to/2026/go-basic.obo",
      "allow_legacy_singular_protein_header": false,
      "allow_all_zero_rows": false,
      "split_overlap_policy": "disallow",
      "source_annotations": {
        "type": "pfp-pickle-directory",
        "path": "/path/to/contemporary/global_nk/pre_projection_pickles",
        "projection_policy": "Supervisor-profile min_count=50 label-universe projection"
      },
      "taxonomy_sources": [
        {"type": "uniprot-dat", "path": "/path/to/2025/trembl.dat.gz", "name": "uniprot-2025-01-trembl", "priority": 100},
        {"type": "uniprot-dat", "path": "/path/to/2025/swissprot.dat.gz", "name": "uniprot-2025-01-swissprot", "priority": 200},
        {"type": "uniprot-dat", "path": "/path/to/2026/trembl.dat.gz", "name": "uniprot-2026-02-trembl", "priority": 300},
        {"type": "uniprot-dat", "path": "/path/to/2026/swissprot.dat.gz", "name": "uniprot-2026-02-swissprot", "priority": 400}
      ],
      "modality_inventory": {
        "type": "long-table",
        "path": "/path/to/contemporary/global_nk/pair_status.tsv",
        "protein_id_column": "protein_id",
        "modality_column": "modality",
        "states": {
          "hydrated_model_input_available": {
            "column": "state",
            "true_values": ["accepted"]
          }
        }
      }
    },
    {
      "id": "contemporary-2025-01-to-2026-02-nk-lk",
      "benchmark_dir": "/path/to/contemporary/nk_lk/csvs",
      "obo_file": "/path/to/2026/go-basic.obo",
      "allow_legacy_singular_protein_header": false,
      "allow_all_zero_rows": false,
      "split_overlap_policy": "per-ontology-disjoint",
      "source_annotations": {
        "type": "pfp-pickle-directory",
        "path": "/path/to/contemporary/nk_lk/pre_projection_pickles",
        "projection_policy": "Contemporary NK+LK min_count=50 label-universe projection"
      },
      "taxonomy_sources": [
        {"type": "uniprot-dat", "path": "/path/to/2025/trembl.dat.gz", "name": "uniprot-2025-01-trembl", "priority": 100},
        {"type": "uniprot-dat", "path": "/path/to/2025/swissprot.dat.gz", "name": "uniprot-2025-01-swissprot", "priority": 200},
        {"type": "uniprot-dat", "path": "/path/to/2026/trembl.dat.gz", "name": "uniprot-2026-02-trembl", "priority": 300},
        {"type": "uniprot-dat", "path": "/path/to/2026/swissprot.dat.gz", "name": "uniprot-2026-02-swissprot", "priority": 400}
      ],
      "modality_inventory": {
        "type": "long-table",
        "path": "/path/to/contemporary/nk_lk/pair_status.tsv",
        "protein_id_column": "protein_id",
        "modality_column": "modality",
        "states": {
          "hydrated_model_input_available": {
            "column": "state",
            "true_values": ["accepted"]
          }
        }
      }
    }
  ]
}

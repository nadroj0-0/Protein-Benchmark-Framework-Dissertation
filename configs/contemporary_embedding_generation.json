{
  "schema_version": 1,
  "description": "Pair-resolved contemporary temporal embedding cache",
  "required_text_cutoff": "2025-03-08",
  "modalities": {
    "sequence": {
      "cache_directory": "prott5",
      "dimension": 1024,
      "min_accepted_fraction": 1.0,
      "model": "Rostlab/prot_t5_xl_half_uniref50-enc"
    },
    "text": {
      "cache_directory": "exp_text_embeddings_temporal",
      "dimension": 768,
      "min_accepted_count": 1,
      "model": "microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract-fulltext",

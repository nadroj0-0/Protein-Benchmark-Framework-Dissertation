      "pooling": "CLS token selected as array[0,0,:]"
    },
    "structure": {
      "cache_directory": "IF1",
      "dimension": 512,
      "min_accepted_count": 1,
      "model": "esm_if1_gvp4_t16_142M_UR50",
      "source_policy": "current AlphaFold API at generation time",
      "pooling": "mean"
    },
    "ppi": {
      "cache_directory": "ppi",
      "dimension": 512,
      "min_accepted_count": 1,
      "source": "STRING protein network embeddings v12.0",
      "alias_policy": "PFP paper-faithful restricted alias sources"
    }
  }
}
